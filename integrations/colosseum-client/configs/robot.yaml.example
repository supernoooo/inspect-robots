## --- Connection and robot ---

## Router WebSocket address.
router_url: wss://191.222.219.43

## Obtain your Client Token from an admin.
token: clt_replace_with_token_from_admin

## Obtain the Institution from an admin; it must match the one bound to your token.
institution: replace_with_institution_from_admin

## Robot implementation: franka | so101 | yam | g1.
## For so101 and yam, start from configs/robot.so101.yaml.example or robot.yam.yaml.example.
## The G1 driver is currently a TODO.
robot_type: franka

## Map camera roles to your physical camera IDs. Replace the placeholders.
## Required for real hardware; with test: true, cameras may be omitted or set to {}.
cameras:
  left_image: "YOUR_LEFT_CAMERA_ID"
  right_image: "YOUR_RIGHT_CAMERA_ID"
  head_image: "YOUR_HEAD_CAMERA_ID"

## Evaluation track: 1 = Open, 2 = Fine-tuning.
track: 1

## Describe the scene/setup for the Open Track evaluation.
scene: office

## Evaluator name stored with the evaluation.
evaluator: local-tester

## Local Policy Server address. Set null to use remote inference through the Router.
policy_server_url: ws://localhost:8000

## --- Optional: evaluation ---

## false uses real hardware; true uses synthetic data without opening hardware.
# test: false

## Open Track instruction. When empty, you will be prompted at startup.
## Fine-tuning uses the instruction from the selected task.
# instruction: ""

## Open Track step limit. Fine-tuning uses the Router task limit.
# max_trial_steps: 800

## --- Optional: hardware ---

## Driver-specific connection and calibration settings.
# adapter_config: {}

## Control frequency in Hz; positive integer matching the controller and assigned model.
# control_hz: 15

## Image dimensions in pixels; each must be a positive integer.
# image_width: 512
# image_height: 288

## --- Optional: recording and upload ---

## Save LeRobot recordings. false disables both recording and dataset upload.
# recording: true

## Output directory, relative to the directory where you run the Client.
# evaluation_dir: eval_runs

## true keeps recordings local instead of automatically uploading them.
## Evaluation results are still submitted to the Router.
# skip_upload: false

## --- Optional: upload to your own dataset ---

## Without dataset_url, recordings use Router-managed upload.
## A custom dataset must be PUBLIC. Requires recording: true and skip_upload: false.
## Install the platform extra alongside the robot extra:
## ModelScope: uv sync --extra franka --extra modelscope (also requires Git).
## Hugging Face: uv sync --extra franka --extra huggingface.
## Example URL; replace with your dataset. Use only one dataset_url entry.
# dataset_url: https://modelscope.cn/datasets/YOUR_ACCOUNT/YOUR_DATASET
# dataset_url: https://huggingface.co/datasets/YOUR_ACCOUNT/YOUR_DATASET

## Example write token for the selected platform; credentials stay on the Client.
## Set either dataset_token or dataset_token_file, not both.
## Alternatively set DATASET_TOKEN, MODELSCOPE_API_TOKEN or HF_TOKEN in the environment.
# dataset_token: YOUR_WRITE_TOKEN_FOR_THE_SELECTED_PLATFORM

## Example token file path, relative to this YAML file.
# dataset_token_file: secrets/dataset-token

## --- Optional: connection and timeouts ---

## HTTP API base URL. When empty, it is derived from router_url.
# api_url: ""

## Model download, loading and warm-up timeout in seconds; integer from 1 to 1800.
# prepare_timeout: 1800

## Per-request inference timeout in milliseconds; positive integer.
# deadline_ms: 30000

## Local Policy Server WebSocket ping interval in seconds; positive integer.
# policy_ping_interval: 20

## Time to wait for a pong in seconds; positive integer, separate from inference timeout.
# policy_ping_timeout: 60

## Use the local Policy Server's effective action contract for the assigned model.
## Requires policy_server_url and a server that reports a compatible effective_model.
# use_local_action_contract: false

# Optional cloud LLM evaluation (requires an updated Router and Policy Server).
# Unset/empty keys do not enable that provider; no keys means VLA-only.
# Key values travel directly to the selected Policy Server, never to Router.
# policy_server_url must be wss:// or ws:// on localhost / an SSH tunnel.
# llm_api_keys:
#   openai: env:OPENAI_API_KEY
#   xai: env:XAI_API_KEY
#   anthropic: env:ANTHROPIC_API_KEY
