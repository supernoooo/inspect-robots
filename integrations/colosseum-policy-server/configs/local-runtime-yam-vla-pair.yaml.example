host: 127.0.0.1
port: 8000
backend:
  name: vla
  options:
    http_timeout_seconds: 30
models:
  - name: molmoact2-yam
    model_type: vla
    url: https://huggingface.co/allenai/MolmoAct2-BimanualYAM
    # Must match the actual local snapshot AND the Router model registration.
    revision: 8dcbed66f2380e4393189c303ea72488eb9e63c2
    action_space: joint_position
    action_dim: 14
    control_hz: 30
    max_horizon: 30
    endpoint: http://127.0.0.1:8202
    backend_options:
      robot_type: yam
      adapter: molmoact2_yam
      num_steps: 10
    # Optional: launch the model worker in its dedicated GPU environment.
    # launcher:
    #   - /absolute/path/to/model-env/bin/colosseum-policy-model
    #   - molmoact2
    #   - --robot-type
    #   - yam
    #   - --checkpoint
    #   - /absolute/path/to/MolmoAct2-BimanualYAM-snapshot
    #   - --dtype
    #   - float32
    #   - --port
    #   - "8202"
  - name: groot-n17-yam
    model_type: vla
    url: https://huggingface.co/NUSMAGIC/GR00T-N1.7-MolmoAct2-YAM
    revision: 5ba9c403bdb962b88c39f843da536eb8370b61b2
    runtime_profile: groot-n17-yam-v1
    action_space: joint_position
    action_dim: 14
    control_hz: 30
    max_horizon: 16
    endpoint: http://127.0.0.1:8203
    backend_options:
      robot_type: yam
      adapter: groot_yam
    # To load models on demand, use absolute executable/asset paths. Run the
    # Python worker directly, not through a shell that leaves GPU children alive.
    # launcher:
    #   - /absolute/path/to/groot-env/bin/colosseum-policy-model
    #   - groot_n17
    #   - --robot-type
    #   - yam
    #   - --checkpoint
    #   - /absolute/path/to/GR00T-N1.7-MolmoAct2-YAM
    #   - --processor
    #   - /absolute/path/to/Qwen3-VL-2B-Instruct
    #   - --base-model
    #   - /absolute/path/to/GR00T-N1.7-3B
    #   - --port
    #   - "8203"
