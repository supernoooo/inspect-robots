# Copy this file to .env and fill in the keys you use. The inspect-robots CLI
# auto-loads .env from the working directory; real environment variables
# take precedence over its values. .env is gitignored: never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Optional: one key that routes any provider/model id through OpenRouter.
OPENROUTER_API_KEY=
